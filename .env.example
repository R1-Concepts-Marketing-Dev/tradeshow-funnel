# Copy to .env and fill in. Never commit .env.
#
# HubSpot private app or OAuth app credentials.
# If you set the refresh-token trio, the access token is refreshed automatically
# on every run and HUBSPOT_ACCESS_TOKEN is only used as a fallback.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REFRESH_TOKEN=

# Who is running the tool. Written into the history log so we know who did what.
TSF_ACTOR=you@r1concepts.com

# WHERE THE REGISTRY LIVES.
#
# This repo is public, so the numbers live in a private one:
#   git clone https://github.com/R1-Concepts-Marketing-Dev/tradeshow-funnel-data
#
# Point this at your clone. Without it the tool writes to ./data, which is
# gitignored here — fine for a quick look, but your work will not be shared
# with anyone and will not be backed up.
TSF_DATA_DIR=C:/path/to/tradeshow-funnel-data

# THE PASSWORD FOR THE PUBLISHED VIEWER.
#
# This is the only place it is written down. Change it here, then run:
#   node bin/tsf.js publish --deploy
#
# Changing it re-encrypts the page, so the old passphrase stops working
# immediately. Anyone with the old one loses access on the next publish.
# .env is gitignored, so this never reaches GitHub.
TSF_PUBLISH_PASSPHRASE=
