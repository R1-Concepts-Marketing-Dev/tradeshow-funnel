# Copy to .env and fill in. Never commit .env.
#
# HubSpot private app or OAuth app credentials.
# If you set the refresh-token trio, the access token is refreshed automatically
# on every run and HUBSPOT_ACCESS_TOKEN is only used as a fallback.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REFRESH_TOKEN=

# Who is running the tool. Written into the history log so we know who did what.
TSF_ACTOR=you@r1concepts.com

# WHERE THE REGISTRY LIVES.
#
# This repo is public, so the numbers live in a private one:
#   git clone https://github.com/R1-Concepts-Marketing-Dev/tradeshow-funnel-data
#
# Point this at your clone. Without it the tool writes to ./data, which is
# gitignored here — fine for a quick look, but your work will not be shared
# with anyone and will not be backed up.
TSF_DATA_DIR=C:/path/to/tradeshow-funnel-data

# THE PASSWORD FOR THE PUBLISHED VIEWER.
#
# This is the only place it is written down. Change it here, then run:
#   node bin/tsf.js publish --deploy
#
# Changing it re-encrypts the page, so the old passphrase stops working — but
# GitHub Pages serves the previous copy from its CDN for a few minutes after a
# deploy, so allow that long before treating access as actually revoked.
# .env is gitignored, so this never reaches GitHub.
TSF_PUBLISH_PASSPHRASE=

# CLAUDE, FOR READING UPLOADED SPREADSHEETS.
#
# Optional. Without it the tool matches columns by name, which works for the
# formats it already knows. With it, Claude reads the shape of each column,
# maps the ones it has never seen, and writes a plain-English summary of the
# file above the mapping table — so nobody has to know what a column mapping is.
#
# Only column names, fill rates, value patterns and MASKED examples
# ("d***@b***.com") are sent. Contact details never leave the machine — see the
# header of src/columnAI.js and the tests in test/columnAI.test.js.
#
# Get a key at console.anthropic.com. Costs roughly a cent per file.
ANTHROPIC_API_KEY=

# Only if you need to point at something other than api.anthropic.com.
# TSF_ANTHROPIC_MODEL=claude-opus-5
# TSF_ANTHROPIC_BASE_URL=

# LETTING OTHER PEOPLE USE THE TOOL.
#
# The tool runs on one machine. `tsf tunnel` puts it on a public link so
# colleagues can upload too, for free, from your PC. Full instructions and the
# permanent alternative are in docs/SHARING.md.
#
# The passphrase is what they type to get in. `tsf tunnel` refuses to open a
# link unless this (or Google sign-in) is set, because a tunnel makes the tool
# reachable from the internet without the server being able to tell.
TSF_ACCESS_PASSPHRASE=

# Signs the login cookie. Not typed by anyone. Set it to any long random string
# so people are not signed out every time you restart.
TSF_SESSION_SECRET=
